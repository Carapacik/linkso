[Unit]
Description=LinkSo PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=linkso
Group=linkso
WorkingDirectory=/opt/linkso
Environment=LINKSO_COMPOSE_FILE=docker-compose.production.yaml
Environment=LINKSO_ENV_FILE=.env.production
Environment=LINKSO_BACKUP_DIR=/var/backups/linkso
ExecStart=/bin/sh /opt/linkso/tool/sh/backup_database.sh
ExecStartPost=/usr/bin/find /var/backups/linkso -type f -name linkso_*.dump -mtime +14 -delete
