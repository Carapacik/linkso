# Copy to .env.production on the Linux host, set mode 600 and replace every CHANGE_ME value.
LINKSO_ENV=production
LINKSO_HTTP_HOST=0.0.0.0
LINKSO_HTTP_PORT=8080
LINKSO_PUBLIC_BASE_URL=http://SERVER_ADDRESS
LINKSO_DATABASE_URL=postgres://linkso:CHANGE_ME_URL_ENCODED@postgres:5432/linkso
LINKSO_DATABASE_MAX_CONNECTIONS=20
LINKSO_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
LINKSO_LOG=linkso_server=info
LINKSO_COOKIE_SECURE=false
# Verified provider credentials; never use local Mailpit or plaintext SMTP here.
LINKSO_SMTP_HOST=CHANGE_ME_SMTP_HOST
LINKSO_SMTP_PORT=587
LINKSO_SMTP_SECURITY=starttls
LINKSO_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
LINKSO_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
LINKSO_MAIL_FROM=LinkSo <CHANGE_ME@example.com>
LINKSO_SMTP_TIMEOUT_SECONDS=10
LINKSO_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
LINKSO_ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
LINKSO_POSTGRES_DB=linkso
LINKSO_POSTGRES_USER=linkso
LINKSO_POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
LINKSO_IMAGE_TAG=CHANGE_ME_RELEASE_OR_COMMIT_ID
