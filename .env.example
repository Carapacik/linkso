# Docker Compose values for local development only.
LINKSO_POSTGRES_DB=linkso
LINKSO_POSTGRES_USER=linkso
LINKSO_POSTGRES_PASSWORD=linkso_local_only
LINKSO_POSTGRES_PORT=5432

# Local test inbox only; no outbound delivery or production credentials.
LINKSO_MAILPIT_SMTP_PORT=1025
LINKSO_MAILPIT_UI_PORT=8025

# Local full-stack profile (`docker compose --profile app up --build`).
LINKSO_PUBLIC_BASE_URL=http://localhost:8088
LINKSO_SESSION_SECRET=linkso_local_session_secret_not_for_production_2026
LINKSO_ADMIN_TOKEN=linkso_local_admin_token_not_for_production_2026
