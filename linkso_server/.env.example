# Local development values only. Copy this file to .env and keep .env untracked.
LINKSO_ENV=development
LINKSO_HTTP_HOST=127.0.0.1
LINKSO_HTTP_PORT=8080
LINKSO_PUBLIC_BASE_URL=http://localhost:8088
LINKSO_DATABASE_URL=postgres://linkso:linkso_local_only@127.0.0.1:5432/linkso
LINKSO_DATABASE_MAX_CONNECTIONS=10
LINKSO_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
LINKSO_LOG=linkso_server=debug,tower_http=info
LINKSO_COOKIE_SECURE=false

# Local Mailpit; start with tool/win/start_mail.bat or sh tool/sh/start_mail.sh.
LINKSO_SMTP_HOST=127.0.0.1
LINKSO_SMTP_PORT=1025
LINKSO_SMTP_SECURITY=none
LINKSO_MAIL_FROM=LinkSo <noreply@linkso.test>
LINKSO_SMTP_TIMEOUT_SECONDS=10
# Leave both credentials empty for local Mailpit. External SMTP requires TLS.
LINKSO_SMTP_USERNAME=
LINKSO_SMTP_PASSWORD=

# Generate a unique random value for every non-local environment.
LINKSO_SESSION_SECRET=linkso_local_session_secret_not_for_production_2026

# Bootstrap credential for administrative API until account roles are introduced in stage 10.
# Generate a different random value with at least 32 bytes outside local development.
LINKSO_ADMIN_TOKEN=linkso_local_admin_token_not_for_production_2026
